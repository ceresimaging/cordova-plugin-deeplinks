{
  "name": "cordova-plugin-deeplinks",
  "version": "2.0.0",
  "description": "Ceres fork of cordova-plugin-deeplinks. Adds Universal Links (iOS) and App Links (Android) support to Cordova apps, with patches for cordova-ios 8.x and Android 12+.",
  "cordova": {
    "id": "cordova-plugin-deeplinks",
    "platforms": [
      "ios",
      "android"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:ceresimaging/cordova-plugin-deeplinks.git"
  },
  "keywords": [
    "cordova",
    "links",
    "universal",
    "deep links",
    "universal links",
    "ecosystem:cordova",
    "cordova-ios",
    "cordova-android",
    "ios",
    "android",
    "ceres"
  ],
  "engines": {
    "node": ">=20.17",
    "cordova-ios": ">=3.8",
    "cordova-android": ">=4"
  },
  "dependencies": {
    "glob": "13.0.6",
    "node-version-compare": "1.0.3",
    "plist": "4.0.0",
    "xcode": "3.0.1",
    "xml2js": "0.6.2"
  },
  "author": "Ceres Imaging <emanzano@ceresimaging.net> (fork; original by Nikolay Demyankov for Nordnet Bank AB)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ceresimaging/cordova-plugin-deeplinks/issues"
  },
  "homepage": "https://github.com/ceresimaging/cordova-plugin-deeplinks#readme"
}
